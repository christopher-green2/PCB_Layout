	(gr_text "DEBUG"
		(at 227.61 170.64 0)
		(layer "F.SilkS")
		(uuid "417fa690-a60c-40f2-8def-e144ecc2059e")
		(effects
			(font
				(size 0.635 0.635)
				(thickness 0.127)
				(bold yes)
			)
			(justify left bottom)
		)
	)
	(gr_text "1"
		(at 250.420121 280.302843 0)
		(layer "F.SilkS")
		(uuid "cea57a7b-f504-43f6-add1-465f4bbc66b0")
		(effects
			(font
				(size 0.635 0.635)
				(thickness 0.127)
				(bold yes)
			)
			(justify left bottom)
		)
	)
	(gr_text "INSTRUCTIONS\n\n1. USB-C Power (5V/1.5A capable) or 18650 3.6V battery required\n2. Insert Target MCU into corresponding target board socket connector.\n3. Plug in target board to CyberDeck socket.\n4. Set desired POWER SUPPLY settings. Push TARGET_PWR_EN.\n5. Wait for CyberDeck to identify target MCU on LCD Screen.\n6. Use breakout pins on Target Boards to access target."
		(at 255.88 215.75 0)
		(layer "F.SilkS")
		(uuid "9d05bd49-5677-4c9c-b5e5-7b946944554a")
		(effects
			(font
				(size 0.635 0.635)
				(thickness 0.127)
				(bold yes)
			)
			(justify left bottom)
		)
	)
	(gr_text "C6"
		(at 211.92 150.32 0)
		(layer "F.SilkS")
		(uuid "ae9f2a75-bcc7-4ad9-81d0-680c1d9b417c")
		(effects
			(font
				(size 0.635 0.635)
				(thickness 0.127)
			)
		)
	)
	(gr_text "CyberDeck supports 1V8/3V3 Target STM32F MCU's.\nToggle switches to set power supply and use the \nTARGET_PWR button to enable victim power. Toggle\nboth switches for AUTO toggle through 1V8 and 3V3 \npower until target MCU is identified.\nIf the board is not identified, Target PWR is set\nto OFF and the target board is simply a breakout\nboard and should be used UNPLUGGED FROM THE CyberDeck \nto avoid damage. RESET, BOOT0, and DEBUG are used for \nprogramming the STM32H7 Parent MCU ONLY."
		(at 286.94 202.56 90)
		(layer "F.SilkS")
		(uuid "e5ed5142-5598-487a-b903-1c3c2f5ce88b")
		(effects
			(font
				(size 0.635 0.635)
				(thickness 0.127)
				(bold yes)
			)
			(justify left bottom)
		)
	)
